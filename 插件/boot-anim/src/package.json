{
  "name": "dsh-plugin-boot-anim",
  "version": "1.0.1",
  "description": "启动动画插件：在设置里多一个「启动动画」分区，点卡片切换工作台的启动画面（配置落 外壳\\data\\boot-animation.json，下次启动生效）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "client/client.js", "catalog.json", "README.md"],
  "dsh": { "client": { "inject": ["@deepseek-ai/dsh-client-ui-settings"], "platform": "web" } },
  "keywords": ["dsh-plugin", "boot-animation", "splash", "启动动画"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashanglinyu/luanyujia-DSH.git",
    "directory": "插件/boot-anim"
  }
}
